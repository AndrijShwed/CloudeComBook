@using CloudeComBook.Shared.Models
@using CloudeComBook.Web.Services
@using CloudeComBook.Web.Helpers
@using MudBlazor
@inject ApiService Api

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Item.NumbOfHouse" Label="Номер будинку" />
            <MudTextField Value="Item.LastName"
                          Immediate="true"
                          ValueChanged="@((string? v) => Item.LastName = TextHelper.CapitalizeWords(v))"
                          Label="Прізвище" />

            <MudTextField Value="Item.Name"
                          Immediate="true"
                          ValueChanged="@((string? v) => Item.Name = TextHelper.CapitalizeWords(v))"
                          Label="Ім'я" />

            <MudTextField Value="Item.Surname"  
                          Immediate="true"
                          ValueChanged="@((string? v) => Item.Surname = TextHelper.CapitalizeWords(v))"
                          Label="По батькові" />
            <MudNumericField @bind-Value="Item.TotalArea" Label="Загальна площа (м²)" />
            <MudNumericField @bind-Value="Item.LivingArea" Label="Житлова площа (м²)" />
            <MudNumericField @bind-Value="Item.TotalOfRooms" Label="Кількість кімнат" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Скасувати</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Зберегти</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public House Item { get; set; } = new();

    private MudForm _form = default!;

    private async Task SaveAsync()
    {
        bool success = Item.IdHouses == 0
            ? await Api.CreateHouseAsync(Item)
            : await Api.UpdateHouseAsync(Item);

        MudDialog.Close(DialogResult.Ok(success));
    }

    private void Cancel() => MudDialog.Cancel();
}
