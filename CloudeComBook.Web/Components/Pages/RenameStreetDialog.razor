@using CloudeComBook.Shared.Models
@using CloudeComBook.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService Api

<MudDialog>
    <TitleContent>Перейменувати вулицю</TitleContent>
    <DialogContent>
        <MudText Class="mb-2">Поточна назва: <b>@CurrentName</b></MudText>
        <MudTextField T="string" @bind-Value="_newName" Label="Нова назва вулиці" Required="true" Class="mb-4" />

        <MudText Typo="Typo.body2" Class="mb-1">Документ про перейменування (.docx)</MudText>
        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".docx">
            <CustomContent Context="fileUpload">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           OnClick="@fileUpload.OpenFilePickerAsync">
                    @(_fileName ?? "Обрати файл")
                </MudButton>
            </CustomContent>
        </MudFileUpload>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Скасувати</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="Submit">
            @(_saving ? "Збереження..." : "Зберегти")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public VillageStreet Item { get; set; } = default!;

    private string CurrentName => Item.StreetName ?? "";
    private string _newName = "";
    private string? _fileName;
    private byte[]? _fileBytes;
    private bool _saving;

    protected override void OnInitialized()
    {
        _newName = CurrentName;
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file == null) return;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            _fileName = null;
            _fileBytes = null;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _fileBytes = ms.ToArray();
        _fileName = file.Name;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        var trimmed = _newName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
            return;

        _saving = true;

        bool renamed = true;
        bool nameChanged = trimmed != CurrentName;

        if (nameChanged)
        {
            renamed = await Api.UpdateStreetAsync(new Street { Id = Item.StreetId, Name = trimmed });
        }

        if (!renamed)
        {
            _saving = false;
            MudDialog.Close(DialogResult.Ok(false));
            return;
        }

        if (nameChanged)
        {
            Item.OldStreetName = CurrentName;
            Item.RenameDate = DateTime.UtcNow;
        }

        if (_fileBytes != null)
        {
            Item.FileData = _fileBytes;
        }

        var updated = await Api.UpdateVillageStreetAsync(Item);
        MudDialog.Close(DialogResult.Ok(updated));
    }
}
