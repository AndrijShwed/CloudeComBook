@page "/animals"

@using CloudeComBook.Shared.Models
@using CloudeComBook.Shared.Filters
@using CloudeComBook.Web.Services
@using CloudeComBook.Web.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ApiService Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Тварини</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">Тварини</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.BarChart"
                   OnClick="OpenStatisticsDialog">
            Статистика
        </MudButton>

        <AuthorizeView Roles="user,admin" Context="addContext">
            <Authorized>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Pets"
                           OnClick="@(() => OpenAnymalDialog(null))">
                    Додати запис
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudStack>

<MudContainer MaxWidth="MaxWidth.False">

    <MudExpansionPanels Class="mb-2 compact-panel" Elevation="1">
        <MudExpansionPanel Class="compact-panel" Text="Фільтри" Expanded="true" Dense="true">

            <MudGrid Spacing="2">

                <MudItem xs="12" sm="6" md="2">
                    <MudTextField Value="_filter.LastName"
                                  Immediate="true"
                                  ValueChanged="@((string? v) => _filter.LastName = TextHelper.CapitalizeWords(v))"
                                  Label="Прізвище"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudTextField Value="_filter.Name"
                                  Immediate="true"
                                  ValueChanged="@((string? v) => _filter.Name = TextHelper.CapitalizeWords(v))"
                                  Label="Ім'я"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudTextField Value="_filter.Surname"
                                  Immediate="true"
                                  ValueChanged="@((string? v) => _filter.Surname = TextHelper.CapitalizeWords(v))"
                                  Label="По батькові"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Label="Населений пункт"
                               @bind-Value="_filter.Village"
                               Variant="Variant.Outlined" Clearable="true"
                               Margin="Margin.Dense" Dense="true">
                        @foreach (var v in _villages)
                        {
                            <MudSelectItem T="string" Value="@v.Name">@v.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

            </MudGrid>

            <MudGrid Spacing="2" Class="mt-1">

                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasCovs" Label="Корови" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasHorses" Label="Коні" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasPigs" Label="Свині" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasSheeps" Label="Вівці" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasGoats" Label="Кози" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasBirds" Label="Птиця" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasRabbits" Label="Кролі" Dense="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="1">
                    <MudCheckBox T="bool" @bind-Value="_filter.HasBeeses" Label="Бджолосім'ї" Dense="true" />
                </MudItem>

            </MudGrid>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="2">
                <MudText Typo="Typo.body2"><b>Кількість записів: @_anymals.Count</b></MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="ClearFilter">
                    Очистити фільтри
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="LoadAnymalsAsync">
                    Пошук
                </MudButton>
            </MudStack>

        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="pa-2">
        <MudTable Items="_anymals" Hover="true" Dense="true" FixedHeader="true"
                  Height="calc(100vh - 350px)">
            <HeaderContent>
                <MudTh>Прізвище</MudTh>
                <MudTh>Ім'я</MudTh>
                <MudTh>По батькові</MudTh>
                <MudTh>Населений пункт</MudTh>
                <MudTh>Корови</MudTh>
                <MudTh>Коні</MudTh>
                <MudTh>Свині</MudTh>
                <MudTh>Вівці</MudTh>
                <MudTh>Кози</MudTh>
                <MudTh>Птиця</MudTh>
                <MudTh>Кролі</MudTh>
                <MudTh>Бджолосім'ї</MudTh>
                <MudTh>Дії</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LastName</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Surname</MudTd>
                <MudTd>@context.Village</MudTd>
                <MudTd>@context.Covs</MudTd>
                <MudTd>@context.Horses</MudTd>
                <MudTd>@context.Pigs</MudTd>
                <MudTd>@context.Sheeps</MudTd>
                <MudTd>@context.Goats</MudTd>
                <MudTd>@context.Birds</MudTd>
                <MudTd>@context.Rabbits</MudTd>
                <MudTd>@context.Beeses</MudTd>
                <MudTd>
                    <AuthorizeView Roles="user,admin" Context="editContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenAnymalDialog(context))" />
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="admin" Context="deleteContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAnymalAsync(context))" />
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

</MudContainer>

@code {
    private AnymalFilter _filter = new();
    private List<Anymal> _anymals = new();
    private List<Village> _villages = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _villages = await Api.GetVillagesAsync();
    }

    private async Task LoadAnymalsAsync()
    {
        _loading = true;
        _anymals = await Api.GetAnymalsAsync(_filter);
        _loading = false;
    }

    private void ClearFilter()
    {
        _filter = new AnymalFilter();
    }

    private async Task OpenAnymalDialog(Anymal? item)
    {
        var isNew = item == null;
        var model = item == null
            ? new Anymal()
            : new Anymal
            {
                AnymalsId = item.AnymalsId,
                LastName = item.LastName,
                Name = item.Name,
                Surname = item.Surname,
                Village = item.Village,
                Anymals = item.Anymals,
                Covs = item.Covs,
                Pigs = item.Pigs,
                Sheeps = item.Sheeps,
                Goats = item.Goats,
                Horses = item.Horses,
                Birds = item.Birds,
                Rabbits = item.Rabbits,
                Beeses = item.Beeses
            };

        var parameters = new DialogParameters<AnymalDialog> { { x => x.Item, model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<AnymalDialog>(
            isNew ? "Додати запис" : "Редагувати запис", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is bool success && success)
        {
            Snackbar.Add("Збережено", Severity.Success);

            if (isNew)
                ClearFilter();
            else
                await LoadAnymalsAsync();
        }
        else if (result is { Canceled: false })
        {
            Snackbar.Add("Не вдалося зберегти", Severity.Error);
        }
    }

    private async Task DeleteAnymalAsync(Anymal item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Підтвердження",
            $"Видалити запис {item.LastName} {item.Name}?",
            yesText: "Видалити", cancelText: "Скасувати");

        if (confirmed != true) return;

        var success = await Api.DeleteAnymalAsync(item.AnymalsId);
        if (success)
        {
            Snackbar.Add("Видалено", Severity.Success);
            await LoadAnymalsAsync();
        }
        else
        {
            Snackbar.Add("Не вдалося видалити", Severity.Error);
        }
    }

    private async Task OpenStatisticsDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<AnymalStatisticsDialog>("Статистика", options);
    }
}