@page "/people"

@using CloudeComBook.Shared.Models
@using CloudeComBook.Web.Services
@using CloudeComBook.Web.ViewModels
@using CloudeComBook.Web.Helpers
@using CloudeComBook.Shared.DTOs
@using CloudeComBook.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ApiService Api
@inject PeopleViewModel Vm
@inject IJSRuntime JS

<PageTitle>Люди</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">Список людей</MudText>
    <AuthorizeView Roles="user,admin" Context="addContext">
        <Authorized>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="@(() => OpenPersonDialog(null))">
                Додати людину
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

<MudContainer MaxWidth="MaxWidth.False">

    <MudExpansionPanels Class="mb-2" Elevation="1">
        <MudExpansionPanel Text="Реєстр жителів — фільтри" Expanded="true" Dense="true">

            <MudGrid Spacing="2">

                <MudItem xs="12">
                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="6" md="2">
                            <MudTextField Value="Vm.Filter.LastName"
                                          Immediate="true"
                                          ValueChanged="@((string? v) => Vm.Filter.LastName = TextHelper.CapitalizeWords(v))"
                                          Label="Прізвище"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Size="Size.Small" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudTextField Value="Vm.Filter.Name"
                                          Immediate="true"
                                          ValueChanged="@((string? v) => Vm.Filter.Name = TextHelper.CapitalizeWords(v))"
                                          Label="Ім'я"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Size="Size.Small" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudTextField Value="Vm.Filter.Surname"
                                          Immediate="true"
                                          ValueChanged="@((string? v) => Vm.Filter.Surname = TextHelper.CapitalizeWords(v))"
                                          Label="По батькові"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Size="Size.Small" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="string"
                                       Label="Стать"
                                       Value="Vm.Filter.Sex"
                                       ValueChanged="@((string? v) => Vm.Filter.Sex = v)"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Margin="Margin.Dense"
                                       Dense="true">

                                <MudSelectItem T="string" Value="@("чол")">
                                    Чоловіча
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("жін")">
                                    Жіноча
                                </MudSelectItem>

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="string"
                                       Label="Статус"
                                       Value="Vm.Filter.Status"
                                       ValueChanged="@((string? v) => Vm.Filter.Status = v)"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Margin="Margin.Dense"
                                       Dense="true">

                                <MudSelectItem T="string" Value="@("помер")">помер</MudSelectItem>
                                <MudSelectItem T="string" Value="@("ЗСУ")">ЗСУ</MudSelectItem>
                                <MudSelectItem T="string" Value="@("одинокий")">одинокий</MudSelectItem>
                                <MudSelectItem T="string" Value="@("ВПО")">ВПО</MudSelectItem>
                                <MudSelectItem T="string" Value="@("безвісти")">безвісти</MudSelectItem>
                                <MudSelectItem T="string" Value="@("не проживає")">не проживає</MudSelectItem>
                                <MudSelectItem T="string" Value="@("відстрочка")">відстрочка</MudSelectItem>
                                <MudSelectItem T="string" Value="@("багатодітний")">багатодітний</MudSelectItem>
                                <MudSelectItem T="string" Value="@("виключений з в/о")">виключений з в/о</MudSelectItem>
                                <MudSelectItem T="string" Value="@("бронь")">бронь</MudSelectItem>
                                <MudSelectItem T="string" Value="@("загинув на війні")">загинув на війні</MudSelectItem>

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudNumericField @bind-Value="Vm.Filter.StatusYear"
                                             Label="Рік зміни статусу"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Size="Size.Small" />
                        </MudItem>

                        

                    </MudGrid>
                </MudItem>

                <MudItem xs="12">
                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="4" md="2">
                            <MudSelect T="int?"
                                       Label="Населений пункт"
                                       Value="Vm.Filter.VillageId"
                                       ValueChanged="Vm.OnVillageChanged"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Margin="Margin.Dense"
                                       Dense="true">

                                @foreach (var v in Vm.Villages)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)v.Id)">
                                        @v.Name
                                    </MudSelectItem>
                                }

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="4" md="2">
                            <MudSelect T="int?"
                                       Label="Вулиця"
                                       Value="Vm.Filter.StreetId"
                                       ValueChanged="Vm.OnStreetChangedAsync"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Disabled="Vm.Filter.VillageId == null"
                                       Margin="Margin.Dense"
                                       Dense="true">

                                @foreach (var vs in Vm.GetStreetsForVillage(Vm.Filter.VillageId))
                                {
                                    <MudSelectItem T="int?" Value="@((int?)vs.StreetId)">
                                        @vs.StreetName
                                    </MudSelectItem>
                                }

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="4" md="2">
                            <MudSelect T="string"
                                       Label="Будинок"
                                       Value="Vm.Filter.HouseNumb"
                                       ValueChanged="@((string? v) => Vm.Filter.HouseNumb = v)"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Disabled="Vm.Filter.StreetId == null"
                                       Margin="Margin.Dense"
                                       Dense="true">

                                @foreach (var h in Vm.Houses)
                                {
                                    <MudSelectItem T="string" Value="@h.NumbOfHouse">
                                        @h.NumbOfHouse
                                    </MudSelectItem>
                                }

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="1">
                            <MudNumericField @bind-Value="Vm.Filter.AgeFrom"
                                             Label="Вік від"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Size="Size.Small" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="1">
                            <MudNumericField @bind-Value="Vm.Filter.AgeTo"
                                             Label="Вік до"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Size="Size.Small" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudStack Row="true"
                                      AlignItems="AlignItems.Center"
                                      Spacing="2"
                                      Class="mt-1">

                                <MudCheckBox T="bool"
                                             Value="Vm.RegisteredYes"
                                             ValueChanged="Vm.SetRegisteredYes"
                                             Label="Реєстрація: так"
                                             Dense="true" />

                                <MudCheckBox T="bool"
                                             Value="Vm.RegisteredNo"
                                             ValueChanged="Vm.SetRegisteredNo"
                                             Label="Реєстрація: ні"
                                             Dense="true" />

                            </MudStack>
                        </MudItem>

                    </MudGrid>
                </MudItem>

            </MudGrid>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Class="mt-2" Spacing="2">

                <MudText Typo="Typo.body2" Class="mb-2">
                <b>Кількість записів: @Vm.People.Count</b>
                </MudText>

                

                <MudSpacer />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="ClearFilter">
                    Очистити фільтри
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="Vm.LoadPeopleAsync">
                    Пошук
                </MudButton>

            </MudStack>

        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="pa-2">

        <MudTable Items="Vm.People"
                  Hover="true" Dense="true" FixedHeader="true"
                  Height="calc(100vh - 350px)"
                  Striped="true"
                  Loading="Vm.Loading"
                  RowClassFunc="GetRowClass">

            <HeaderContent>
                <MudTh>Прізвище</MudTh>
                <MudTh>Ім'я</MudTh>
                <MudTh>По батькові</MudTh>
                <MudTh>Дата народження</MudTh>
                <MudTh>Стать</MudTh>
                <MudTh>Статус</MudTh>
                <MudTh>Населений пункт</MudTh>
                <MudTh>Вулиця</MudTh>
                <MudTh>Будинок</MudTh>
                <MudTh>Реєстрація</MudTh>
                <MudTh>Дії</MudTh>
                <MudTh>Довідка</MudTh>
            </HeaderContent>
          
            <RowTemplate>
                <MudTd>@context.LastName</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Surname</MudTd>
                <MudTd>@context.DateOfBirth?.ToString("dd.MM.yyyy")</MudTd>
                <MudTd>@context.Sex</MudTd>
                <MudTd>@context.Status</MudTd>
                <MudTd>@context.VillageName</MudTd>
                <MudTd>@context.StreetName</MudTd>
                <MudTd>@context.NumbOfHouse</MudTd>
                <MudTd>@context.Registr</MudTd>
                <MudTd>
                    <AuthorizeView Roles="user,admin" Context="editContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenPersonDialog(context))" />
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="admin" Context="deleteContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeletePersonAsync(context))" />
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Filled.Description"
                             Color="Color.Secondary"
                             Size="Size.Small"
                             Dense="true">
                        @foreach (var type in DocumentTypeConfig.DisplayNames)
                        {
                            <MudMenuItem OnClick="@(() => GenerateDocumentAsync(context, type.Key))">
                                @type.Value
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>
    .row-pomer td {
        background-color: #343a40 !important;
        color: white !important;
    }

    .row-vybuv td {
        background-color: #e8a0b5 !important;
        color: white !important;
    }
</style>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await Vm.InitializeAsync();
    }

    private async Task ClearFilter()
    {
        Vm.ClearFilter();
        // await Vm.LoadPeopleAsync();
    }

    private string GetRowClass(Person context, int rowNumber)
    {

        if (context.Registr == "ні")
        {
            if (context.Status == "помер" || context.Status == "загинув на війні")
            {
                return "row-pomer";
            }
            else
            {
                return "row-vybuv";
            }
        }
        
        return string.Empty;
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private async Task OpenPersonDialog(Person? item)
    {
        var isNew = item == null;
        var model = item == null
            ? new Person()
            : new Person
            {
                PeopleId = item.PeopleId,
                LastName = item.LastName,
                Name = item.Name,
                Surname = item.Surname,
                Sex = item.Sex,
                DateOfBirth = item.DateOfBirth,
                NumbOfHouse = item.NumbOfHouse,
                Passport = item.Passport,
                IdKod = item.IdKod,
                PhoneNumber = item.PhoneNumber,
                Status = item.Status,
                Registr = item.Registr,
                MilID = item.MilID,
                VillageStreetId = item.VillageStreetId,
                Description = item.Description
            };

        var parameters = new DialogParameters<PersonDialog>
    {
        { "Item", model }
    };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<PersonDialog>(
            isNew ? "Додати людину" : "Редагувати людину", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is bool success && success)
        {
            Snackbar.Add("Збережено", Severity.Success);
            Vm.ClearFilter();
        }
        else if (result is { Canceled: false })
        {
            Snackbar.Add("Не вдалося зберегти", Severity.Error);
        }
    }

    private async Task DeletePersonAsync(Person item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Підтвердження",
            $"Видалити {item.LastName} {item.Name}?",
            yesText: "Видалити", cancelText: "Скасувати");

        if (confirmed != true) return;

        var success = await Api.DeletePersonAsync(item.PeopleId);
        if (success)
        {
            Snackbar.Add("Видалено", Severity.Success);
            await Vm.LoadPeopleAsync();
        }
        else
        {
            Snackbar.Add("Не вдалося видалити", Severity.Error);
        }
    }

    private async Task GenerateDocumentAsync(Person person, string templateType)
    {
        var fieldSpecs = DocumentTypeConfig.GetFields(templateType);
        Dictionary<string, string> extraFields = new();

        if (fieldSpecs.Count > 0)
        {
            var parameters = new DialogParameters<DocumentFieldsDialog> { {"Fields", fieldSpecs } };
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

            var dialog = await DialogService.ShowAsync<DocumentFieldsDialog>(
                $"Дані для: {DocumentTypeConfig.DisplayNames[templateType]}", parameters, options);
            var result = await dialog.Result;

            if (result is { Canceled: true } || result?.Data == null)
                return;

            extraFields = (Dictionary<string, string>)result.Data;
        }

        var request = new GenerateDocumentRequest
        {
            TemplateType = templateType,
            PersonId = person.PeopleId,
            ExtraFields = extraFields
        };

        var generated = await Api.GenerateDocumentAsync(request);

        if (generated == null)
        {
            Snackbar.Add("Не вдалося сформувати документ. Перевірте, чи завантажено шаблон.", Severity.Error);
            return;
        }

        await DownloadFileAsync(generated.Value.FileName, generated.Value.Bytes);
    }

    private async Task DownloadFileAsync(string fileName, byte[] bytes)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName,
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document", base64);
    }
}