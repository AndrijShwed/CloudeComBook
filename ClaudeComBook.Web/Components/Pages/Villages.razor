@page "/villages"
@using ClaudeComBook.Shared.Models
@using ClaudeComBook.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Населені пункти</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Населені пункти</MudText>
    <AuthorizeView Roles="user,admin" Context="authContext">
        <Authorized>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateForm">
                Додати населений пункт
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="@_villages" Hover="true" Dense="true" FixedHeader="true"
              Height="calc(100vh - 330px)">
        <HeaderContent>
            <MudTh>Назва</MudTh>
            <MudTh>Дії</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Назва">@context.Name</MudTd>
            <MudTd DataLabel="Дії">
                <MudStack Row="true" Spacing="1">
                    <AuthorizeView Roles="user,admin" Context="editContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditForm(context))" />
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="admin" Context="delContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(context))" />
                        </Authorized>
                    </AuthorizeView>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private List<Village> _villages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _villages = await Api.GetVillagesAsync();
        _loading = false;
    }

    private async Task OpenCreateForm()
    {
        var dialog = await DialogService.ShowAsync<VillageDialog>("Новий населений пункт");
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Населений пункт додано", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditForm(Village village)
    {
        var parameters = new DialogParameters<VillageDialog> { { x => x.Village, village } };
        var dialog = await DialogService.ShowAsync<VillageDialog>("Редагувати населений пункт", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Зміни збережено", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Village village)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Підтвердження видалення",
            $"Видалити населений пункт \"{village.Name}\"?",
            yesText: "Видалити", cancelText: "Скасувати");

        if (confirmed != true)
            return;

        var success = await Api.DeleteVillageAsync(village.Id);

        if (success)
        {
            Snackbar.Add("Видалено", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Не вдалося видалити (можливо, є пов'язані записи)", Severity.Error);
        }
    }
}
