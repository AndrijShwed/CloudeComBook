@page "/Admin/Templates"
@using CloudComBook.Shared.DTOs
@using CloudComBook.Web.Helpers
@using CloudComBook.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "admin")]

<PageTitle>Шаблони довідок</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Шаблони довідок</MudText>

<AuthorizeView Roles="superadmin" Context="saContext">
    <NotAuthorized>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Шаблони спільні для всіх громад. Завантажувати й замінювати їх може лише супер-адміністратор;
            ви можете переглянути статус і завантажити поточний шаблон.
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="@_statuses" Hover="true" Dense="true" FixedHeader="true"
              Height="calc(100vh - 330px)">
        <HeaderContent>
            <MudTh Style="background-color: lightgreen;">Тип довідки</MudTh>
            <MudTh Style="background-color: lightgreen;">Статус</MudTh>
            <MudTh Style="background-color: lightgreen;">Оновлено</MudTh>
            <MudTh Style="background-color: lightgreen;">Дії</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Тип довідки">
                @DocumentTypeConfig.DisplayNames.GetValueOrDefault(context.Type, context.Type)
            </MudTd>
            <MudTd DataLabel="Статус">
                @if (context.Exists)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Завантажено</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Відсутній</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Оновлено">
                @(context.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
            </MudTd>
            <MudTd DataLabel="Дії">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">

                    <AuthorizeView Roles="superadmin" Context="uploadContext">
                        <Authorized>
                            <MudFileUpload T="IBrowserFile" FilesChanged="@(file => UploadAsync(context.Type, file))" Accept=".docx">
                                <CustomContent Context="fileUpload">
                                    <MudButton Variant="Variant.Filled"
                                               Color="@(context.Exists ? Color.Warning : Color.Primary)"
                                               StartIcon="@(context.Exists ? Icons.Material.Filled.Autorenew : Icons.Material.Filled.UploadFile)"
                                               Size="Size.Small"
                                               OnClick="@fileUpload.OpenFilePickerAsync">
                                        @(context.Exists ? "Замінити" : "Завантажити")
                                    </MudButton>
                                </CustomContent>
                            </MudFileUpload>
                        </Authorized>
                    </AuthorizeView>

                    @if (context.Exists)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Title="Завантажити шаблон"
                                       OnClick="@(() => DownloadAsync(context.Type))" />
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private List<DocumentTemplateStatusDto> _statuses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _statuses = await Api.GetTemplateStatusesAsync();
        _loading = false;
    }

    private async Task UploadAsync(string type, IBrowserFile file)
    {
        if (file == null) return;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Дозволено лише файли .docx", Severity.Warning);
            return;
        }

        var (success, error) = await Api.UploadTemplateAsync(type, file);

        if (success)
        {
            Snackbar.Add("Шаблон завантажено", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Не вдалося завантажити шаблон", Severity.Error);
        }
    }

    private async Task DownloadAsync(string type)
    {
        var result = await Api.DownloadTemplateAsync(type);
        if (result == null)
        {
            Snackbar.Add("Файл не знайдено", Severity.Error);
            return;
        }

        var base64 = Convert.ToBase64String(result.Value.Bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", result.Value.FileName,
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document", base64);
    }
}