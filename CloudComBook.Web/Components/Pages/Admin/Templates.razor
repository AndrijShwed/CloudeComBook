@page "/Admin/Templates"
@using CloudComBook.Shared.DTOs
@using CloudComBook.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "admin")]

<PageTitle>Шаблони довідок</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Шаблони довідок</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="@_statuses" Hover="true" Dense="true" FixedHeader="true"
              Height="calc(100vh - 330px)">
        <HeaderContent>
            <MudTh>Тип довідки</MudTh>
            <MudTh>Статус</MudTh>
            <MudTh>Оновлено</MudTh>
            <MudTh>Дії</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Тип довідки">@context.Type</MudTd>
            <MudTd DataLabel="Статус">
                @if (context.Exists)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Завантажено</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Відсутній</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Оновлено">
                @(context.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
            </MudTd>
                <MudTd DataLabel="Дії">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@(file => UploadAsync(context.Type, file))" Accept=".docx">
                        <CustomContent Context="fileUpload">
                            <MudButton Variant="Variant.Filled"
                                       Color="@(context.Exists ? Color.Warning : Color.Primary)"
                                       StartIcon="@(context.Exists ? Icons.Material.Filled.Autorenew : Icons.Material.Filled.UploadFile)"
                                       Size="Size.Small"
                                       OnClick="@fileUpload.OpenFilePickerAsync">
                                @(context.Exists ? "Замінити" : "Завантажити")
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>

                        @if (context.Exists)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Color="Color.Default"
                                           Size="Size.Small"
                                           OnClick="@(() => DownloadAsync(context.Type))" />
                        }
                    </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private List<DocumentTemplateStatusDto> _statuses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _statuses = await Api.GetTemplateStatusesAsync();
        _loading = false;
    }

    private async Task UploadAsync(string type, IBrowserFile file)
    {
        if (file == null) return;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Дозволено лише файли .docx", Severity.Warning);
            return;
        }

        var success = await Api.UploadTemplateAsync(type, file);

        if (success)
        {
            Snackbar.Add("Шаблон завантажено", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Не вдалося завантажити шаблон", Severity.Error);
        }
    }

    private async Task DownloadAsync(string type)
    {
        var result = await Api.DownloadTemplateAsync(type);
        if (result == null)
        {
            Snackbar.Add("Файл не знайдено", Severity.Error);
            return;
        }

        var base64 = Convert.ToBase64String(result.Value.Bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", result.Value.FileName,
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document", base64);
    }
}
