@page "/Admin/Users"
@using CloudComBook.Shared.DTOs.Auth
@using CloudComBook.Shared.Models
@using CloudComBook.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MudBlazor
@inject IDialogService DialogService
@inject ApiService Api
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "admin")]

<PageTitle>Керування користувачами</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Користувачі</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenCreateForm">
        Додати користувача
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="@_users" Hover="true" Dense="true" FixedHeader="true"
              Height="calc(100vh - 330px)">
        <HeaderContent>
            <MudTh Style="background-color: lightgreen;">Логін</MudTh>
            <MudTh Style="background-color: lightgreen;">ПІБ</MudTh>
            <MudTh Style="background-color: lightgreen;">Роль</MudTh>
            <MudTh Style="background-color: lightgreen;">Посада</MudTh>
            <MudTh Style="background-color: lightgreen;">Активний</MudTh>
            @if (_isSuperAdmin)
            {
                <MudTh Style="background-color: lightgreen;">Громада</MudTh>
            }
            <MudTh Style="background-color: lightgreen;">Дії</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Логін">@context.Login</MudTd>
            <MudTd DataLabel="ПІБ">@context.FullName</MudTd>
            <MudTd DataLabel="Роль">@context.Role</MudTd>
            <MudTd DataLabel="Посада">@context.Position</MudTd>
            <MudTd DataLabel="Активний">
                <MudSwitch T="bool" Value="@context.IsActive"
                           ValueChanged="@(async (bool v) => await ToggleActiveAsync(context, v))"
                           Disabled="@IsSelf(context)"
                           Color="Color.Success" />
            </MudTd>
            @if (_isSuperAdmin)
            {
                <MudTd DataLabel="Громада">@CommunityName(context)</MudTd>
            }
            <MudTd DataLabel="Дії">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Title="Редагувати"
                               OnClick="@(() => OpenEditForm(context))" />
                @if (CanDelete(context))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Title="Видалити"
                                   OnClick="@(() => DeleteAsync(context.Id, context.Login))" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private bool _isSuperAdmin;
    private int _currentUserId;
    private List<UserProfileResponse> _users = new();
    private List<Community> _communities = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _isSuperAdmin = auth.User.IsInRole("superadmin");
        int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId);

        // список громад API віддає лише супер-адміну
        if (_isSuperAdmin)
            _communities = await Api.GetCommunitiesAsync();

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        _users = await Api.GetUsersAsync();
        _loading = false;
    }

    private bool IsSelf(UserProfileResponse u) => u.Id == _currentUserId;

    // адмінів видаляє лише супер-адмін; себе видаляти не можна
    private bool CanDelete(UserProfileResponse u) =>
        !IsSelf(u) && (_isSuperAdmin || u.Role is not ("admin" or "superadmin"));

    private string CommunityName(UserProfileResponse u) =>
        u.Role == "superadmin"
            ? "Усі громади"
            : _communities.FirstOrDefault(c => c.Id == u.CommunityId)?.Name ?? "Не визначено";

    private async Task OpenCreateForm()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CreateUserDialog>("Новий користувач", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: bool ok } && ok)
        {
            Snackbar.Add("Користувача створено", Severity.Success);
            await LoadUsersAsync();
        }
        else if (result is { Canceled: false })
        {
            Snackbar.Add("Не вдалося створити користувача (можливо, такий логін уже існує)", Severity.Error);
        }
    }

    private async Task OpenEditForm(UserProfileResponse user)
    {
        var parameters = new DialogParameters<EditUserDialog>
        {
            { x => x.Item, user },
            { x => x.IsSelf, IsSelf(user) },
            { x => x.IsSuperAdmin, _isSuperAdmin },
            { x => x.Communities, _communities }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<EditUserDialog>("Редагувати користувача", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: bool ok } && ok)
        {
            Snackbar.Add("Збережено", Severity.Success);
            await LoadUsersAsync();
        }
    }

    private async Task DeleteAsync(int id, string login)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Підтвердження видалення",
            $"Ви дійсно хочете видалити користувача \"{login}\"? Цю дію неможливо скасувати.",
            yesText: "Видалити", cancelText: "Скасувати");

        if (confirmed != true)
            return;

        var (success, error) = await Api.DeleteUserAsync(id);

        if (success)
        {
            Snackbar.Add("Користувача видалено", Severity.Success);
            await LoadUsersAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Не вдалося видалити користувача", Severity.Error);
        }
    }

    private async Task ToggleActiveAsync(UserProfileResponse user, bool isActive)
    {
        var success = await Api.ToggleUserActiveAsync(user.Id, isActive);

        if (success)
        {
            user.IsActive = isActive;
            Snackbar.Add(isActive ? "Користувача активовано" : "Користувача деактивовано", Severity.Success);
        }
        else
        {
            Snackbar.Add("Не вдалося змінити статус", Severity.Error);
        }
    }
}