@page "/enterprises"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using CloudComBook.Shared.Models
@using CloudComBook.Shared.Filters
@using CloudComBook.Web.Services
@using CloudComBook.Web.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ApiService Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Підприємства</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">Підприємства</MudText>
    <AuthorizeView Roles="user,admin" Context="addContext">
        <Authorized>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Business"
                       OnClick="@(() => OpenEnterpriseDialog(null))">
                Додати підприємство
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

<MudContainer MaxWidth="MaxWidth.False">

    <MudExpansionPanels Class="mb-2 compact-panel" Elevation="1">
        <MudExpansionPanel Class="compact-panel" Text="Фільтри" Expanded="true" Dense="true">

            <MudGrid Spacing="2">

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_filter.Name"
                                  Immediate="true"
                                  Label="Назва"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Value="_filter.Owner"
                                  Immediate="true"
                                  ValueChanged="@((string? v) => _filter.Owner = TextHelper.CapitalizeWords(v))"
                                  Label="Власник / керівник"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="int?" Label="Населений пункт"
                               Value="_filter.VillageId"
                               ValueChanged="OnVillageChanged"
                               Variant="Variant.Outlined" Clearable="true"
                               Margin="Margin.Dense" Dense="true">
                        @foreach (var v in _villages)
                        {
                            <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="int?" Label="Вулиця"
                               Value="_filter.StreetId"
                               ValueChanged="OnStreetChangedAsync"
                               Variant="Variant.Outlined" Clearable="true"
                               Disabled="_filter.VillageId == null"
                               Margin="Margin.Dense" Dense="true">
                        @foreach (var vs in _availableStreets)
                        {
                            <MudSelectItem T="int?" Value="@((int?)vs.StreetId)">@vs.StreetName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Label="Будинок"
                               @bind-Value="_filter.HouseNumber"
                               Variant="Variant.Outlined" Clearable="true"
                               Disabled="_selectedVillageStreetId == null"
                               Margin="Margin.Dense" Dense="true">
                        @foreach (var h in _availableHouses)
                        {
                            <MudSelectItem T="string" Value="@h.NumbOfHouse">@h.NumbOfHouse</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

            </MudGrid>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="2">
                <MudText Typo="Typo.body2"><b>Кількість записів: @_enterprises.Count</b></MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="ClearFilter">
                    Очистити фільтри
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="LoadEnterprisesAsync">
                    Пошук
                </MudButton>
            </MudStack>

        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="pa-2">
        <MudTable Items="_enterprises" Hover="true" Dense="true" FixedHeader="true"
                  Height="calc(100vh - 310px)" Striped="true" Loading="_loading">
            <HeaderContent>
                <MudTh>Назва</MudTh>
                <MudTh>Власник / керівник</MudTh>
                <MudTh>Кількість працівників</MudTh>
                <MudTh>Населений пункт</MudTh>
                <MudTh>Вулиця</MudTh>
                <MudTh>Будинок</MudTh>
                <MudTh>Дії</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Owner</MudTd>
                <MudTd>@context.EmployeesNumber</MudTd>
                <MudTd>@context.VillageName</MudTd>
                <MudTd>@context.StreetName</MudTd>
                <MudTd>@context.HouseNumber</MudTd>
                <MudTd>
                    <AuthorizeView Roles="user,admin" Context="editContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenEnterpriseDialog(context))" />
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="admin" Context="deleteContext">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteEnterpriseAsync(context))" />
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

</MudContainer>

@code {
    private EnterpriseFilter _filter = new();
    private List<Enterprise> _enterprises = new();
    private List<Village> _villages = new();
    private List<VillageStreet> _villageStreets = new();
    private List<VillageStreet> _availableStreets = new();
    private List<House> _availableHouses = new();
    private int? _selectedVillageStreetId;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _villages = await Api.GetVillagesAsync();
        _villageStreets = await Api.GetVillageStreetsAsync();
    }

    private async Task LoadEnterprisesAsync()
    {
        _loading = true;
        _enterprises = await Api.GetEnterprisesAsync(_filter);
        _loading = false;
    }

    private void OnVillageChanged(int? villageId)
    {
        _filter.VillageId = villageId;
        _filter.StreetId = null;
        _filter.HouseNumber = null;
        _selectedVillageStreetId = null;
        _availableHouses = new List<House>();

        _availableStreets = villageId == null
            ? new List<VillageStreet>()
            : _villageStreets.Where(vs => vs.VillageId == villageId && vs.IsActive).ToList();
    }

    private async Task OnStreetChangedAsync(int? streetId)
    {
        _filter.StreetId = streetId;
        _filter.HouseNumber = null;

        var vs = _availableStreets.FirstOrDefault(x => x.StreetId == streetId);
        _selectedVillageStreetId = vs?.Id;

        _availableHouses = vs == null
            ? new List<House>()
            : (await Api.GetHousesByVillageStreetIdAsync(vs.Id))
                .OrderBy(h => GetHouseNumberSortKey(h.NumbOfHouse))
                .ThenBy(h => h.NumbOfHouse, StringComparer.OrdinalIgnoreCase)
                .ToList();
    }

    private static int GetHouseNumberSortKey(string? numb)
    {
        if (string.IsNullOrWhiteSpace(numb))
            return int.MaxValue;

        var digits = new string(numb.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : int.MaxValue;
    }

    private void ClearFilter()
    {
        _filter = new EnterpriseFilter();
        _selectedVillageStreetId = null;
        _availableStreets = new List<VillageStreet>();
        _availableHouses = new List<House>();
    }

    private async Task OpenEnterpriseDialog(Enterprise? item)
    {
        var isNew = item == null;
        var model = item == null
            ? new Enterprise()
            : new Enterprise
            {
                Id = item.Id,
                Name = item.Name,
                Owner = item.Owner,
                EmployeesNumber = item.EmployeesNumber,
                VillageStreetId = item.VillageStreetId,
                HouseNumber = item.HouseNumber
            };

        var parameters = new DialogParameters<EnterpriseDialog> { { x => x.Item, model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<EnterpriseDialog>(
            isNew ? "Додати підприємство" : "Редагувати підприємство", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is bool success && success)
        {
            Snackbar.Add("Збережено", Severity.Success);

            if (isNew)
                ClearFilter();
            else
                await LoadEnterprisesAsync();
        }
        else if (result is { Canceled: false })
        {
            Snackbar.Add("Не вдалося зберегти", Severity.Error);
        }
    }

    private async Task DeleteEnterpriseAsync(Enterprise item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Підтвердження",
            $"Видалити підприємство \"{item.Name}\"?",
            yesText: "Видалити", cancelText: "Скасувати");

        if (confirmed != true) return;

        var success = await Api.DeleteEnterpriseAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Видалено", Severity.Success);
            await LoadEnterprisesAsync();
        }
        else
        {
            Snackbar.Add("Не вдалося видалити", Severity.Error);
        }
    }
}
