@using System.Text.Json
@using System.Text.RegularExpressions
@using CloudComBook.Shared.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudStack Spacing="1" Class="mb-3">
            <MudText Typo="Typo.body2">
                <b>@ActionName(Entry.Action)</b> · @Entry.UserLogin · @Entry.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")
            </MudText>
            <MudText Typo="Typo.body2">Запис №@(Entry.EntityId?.ToString() ?? "—")</MudText>
        </MudStack>

        @if (Entry.Action == "UPDATE")
        {
            <MudSwitch T="bool" @bind-Value="_showAll" Color="Color.Primary" Label="Показати всі поля" />
        }

        @if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Немає даних для відображення.</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Style="max-height: 60vh; overflow-y: auto;">
                <thead>
                    <tr>
                        <th>Поле</th>
                        @if (Entry.Action != "CREATE")
                        {
                            <th>Було</th>
                        }
                        @if (Entry.Action != "DELETE")
                        {
                            <th>Стало</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rows.Where(x => _showAll || Entry.Action != "UPDATE" || x.Changed))
                    {
                        <tr style="@(r.Changed && Entry.Action == "UPDATE" ? "background-color:#fff3cd;color:#000;" : "")">
                            <td><b>@r.Label</b></td>
                            @if (Entry.Action != "CREATE")
                            {
                                <td>@r.Old</td>
                            }
                            @if (Entry.Action != "DELETE")
                            {
                                <td>@r.New</td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Закрити</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AuditLogEntry Entry { get; set; } = default!;

    private record Row(string Label, string Old, string New, bool Changed);

    private List<Row> _rows = new();
    private bool _showAll;

    private static readonly Dictionary<string, string> Labels = new()
    {
        ["LastName"] = "Прізвище",
        ["Surname"] = "По батькові",
        ["FullName"] = "ПІБ",
        ["DateOfBirth"] = "Дата народження",
        ["Sex"] = "Стать",
        ["Status"] = "Статус",
        ["Registr"] = "Реєстрація",
        ["NumbOfHouse"] = "Будинок",
        ["Passport"] = "Паспорт",
        ["IdKod"] = "ІПН",
        ["PhoneNumber"] = "Телефон",
        ["Description"] = "Опис",
        ["MDate"] = "Дата зміни статусу",
        ["VillageStreetId"] = "Вулиця в н.п. (id)",
        ["Login"] = "Логін",
        ["Role"] = "Роль",
        ["Position"] = "Посада",
        ["IsActive"] = "Активний",
        ["CommunityId"] = "Громада (id)",
        ["TotalArea"] = "Загальна площа",
        ["LivingArea"] = "Житлова площа",
        ["TotalOfRooms"] = "Кількість кімнат",
        ["HouseNumber"] = "Номер будинку"
    };

    protected override void OnInitialized()
    {
        var old = Parse(Entry.OldValues);
        var now = Parse(Entry.NewValues);

        var keys = now.Keys.Concat(old.Keys).Distinct().ToList();

        _rows = keys.Select(k =>
        {
            var o = old.GetValueOrDefault(k, "—");
            var n = now.GetValueOrDefault(k, "—");
            return new Row(Labels.GetValueOrDefault(k, k), o, n, o != n);
        }).ToList();

        // якщо змін не виявлено, показуємо все
        _showAll = Entry.Action == "UPDATE" && !_rows.Any(r => r.Changed);
    }

    private static Dictionary<string, string> Parse(string? json)
    {
        var result = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(json)) return result;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                foreach (var p in doc.RootElement.EnumerateObject())
                    result[p.Name] = Format(p.Value);
            }
            else
            {
                result["Значення"] = Format(doc.RootElement);
            }
        }
        catch (JsonException)
        {
            result["Дані"] = json;
        }

        return result;
    }

    private static string Format(JsonElement e) => e.ValueKind switch
    {
        JsonValueKind.Null => "—",
        JsonValueKind.True => "так",
        JsonValueKind.False => "ні",
        JsonValueKind.String => FormatString(e.GetString()),
        _ => e.ToString()
    };

    private static string FormatString(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "—";

        // дати з JSON виглядають як 2026-09-01T00:00:00
        if (Regex.IsMatch(s, @"^\d{4}-\d{2}-\d{2}T") && DateTime.TryParse(s, out var d))
            return d.TimeOfDay == TimeSpan.Zero ? d.ToString("dd.MM.yyyy") : d.ToString("dd.MM.yyyy HH:mm");

        return s;
    }

    private static string ActionName(string action) => action switch
    {
        "CREATE" => "Створення",
        "UPDATE" => "Зміна",
        "DELETE" => "Видалення",
        _ => action
    };

    private void Close() => MudDialog.Close();
}
