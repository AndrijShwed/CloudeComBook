@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inherits LayoutComponentBase

@using CloudComBook.Web.Theme

@using CloudComBook.Shared.Models
@using CloudComBook.Web.Services
@inject ApiService Api
@inject IHttpContextAccessor HttpContextAccessor

<MudThemeProvider Theme="@AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Dense="false" Elevation="1">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

            <MudIcon Icon="@Icons.Material.Filled.AccountBalance"
                     Size="Size.Medium" />

            <MudText Typo="Typo.h5">
                CloudComBook
            </MudText>

        </MudStack>

        <MudSpacer />

        <AuthorizeView Roles="superadmin" Context="saContext">
            <Authorized>
                <MudSelect T="int?" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="min-width: 260px; color: white;"
                           Label="Громада"
                           Value="_selectedCommunityId"
                           ValueChanged="OnCommunityChanged">
                    <MudSelectItem T="int?" Value="@((int?)null)">Усі громади (лише перегляд)</MudSelectItem>
                    @foreach (var c in _communities)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Context="authContext">
            <Authorized>
                <MudMenu>
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.AccountCircle"
                                   OnClick="@context.ToggleAsync">
                            @DisplayName
                        </MudButton>
                    </ActivatorContent>

                    <ChildContent>
                        <MudText Class="px-4 pt-2 pb-1" Typo="Typo.caption" Color="Color.Secondary">
                            Роль: @RoleName
                        </MudText>

                        <MudDivider Class="my-1" />

                        <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/Account/Profile">
                            Профіль
                        </MudMenuItem>

                        <MudMenuItem Icon="@Icons.Material.Filled.Settings">
                            Налаштування
                        </MudMenuItem>

                        <MudDivider />

                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">
                            Вийти
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/Account/Login">
                    Увійти
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               Elevation="1">

        <MudNavMenu Dense="true">

            <AuthorizeView Roles="admin" Context="adminContext">
                <Authorized>
                    <MudNavLink Href="/Admin/Users"
                                Icon="@Icons.Material.Filled.ManageAccounts">
                        Користувачі
                    </MudNavLink>
                    <MudNavLink Href="/Admin/Templates"
                                Icon="@Icons.Material.Filled.Description">
                        Шаблони довідок
                    </MudNavLink>
                    <MudNavLink Href="/Admin/Audit" 
                                Icon="@Icons.Material.Filled.History">
                        Журнал змін
                    </MudNavLink>
                    <MudDivider Class="my-2" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="superadmin" Context="saNav">
                <Authorized>
                    <MudNavLink Href="/Admin/Communities" Icon="@Icons.Material.Filled.Domain">
                        Громади
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home">
                Головна
            </MudNavLink>

            <MudNavLink Href="/people"
                        Icon="@Icons.Material.Filled.People">
                Люди
            </MudNavLink>

            <MudNavLink Href="/houses"
                        Icon="@Icons.Material.Filled.HomeWork">
                Будинки
            </MudNavLink>

            <MudNavLink Href="/villages" Icon="@Icons.Material.Filled.LocationCity">
                Населені пункти
            </MudNavLink>

            <MudNavLink Href="/streets"
                        Icon="@Icons.Material.Filled.Route">
                Вулиці
            </MudNavLink>

            <MudNavLink Href="/village-streets" Icon="@Icons.Material.Filled.Signpost">
                Вулиці в н.п.
            </MudNavLink>

            <MudNavLink Href="/animals"
                        Icon="@Icons.Material.Filled.Pets">
                Тварини
            </MudNavLink>

            <MudNavLink Href="/plots"
                        Icon="@Icons.Material.Filled.Landscape">
                Земельні ділянки
            </MudNavLink>

            <MudNavLink Href="/enterprises"
                        Icon="@Icons.Material.Filled.Business">
                Підприємства
            </MudNavLink>

            <MudDivider Class="my-2" />

        </MudNavMenu>

    </MudDrawer>

    <MudMainContent Class="pa-6">
        <div style="padding-top: 50px;">
            @Body
        </div>
    </MudMainContent>

</MudLayout>

@code
{
    private bool _drawerOpen = true;
    private List<Community> _communities = new();
    private int? _selectedCommunityId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string DisplayName = "";
    private string RoleName = "";

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.IsInRole("superadmin"))
            {
                _communities = await Api.GetCommunitiesAsync();
                if (int.TryParse(HttpContextAccessor.HttpContext?.Request.Cookies["community_id"], out var cid))
                    _selectedCommunityId = cid;
            }
            DisplayName = user.FindFirst("ShortName")?.Value ?? user.Identity?.Name ?? "";
            RoleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/Account/Logout", forceLoad: true);
    }

    private void OnCommunityChanged(int? id)
    {
        // перезавантаження з нуля, щоб усі сторінки перечитали дані для нової громади
        var back = Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Insert(0, "/"));
        NavigationManager.NavigateTo($"/Account/SetCommunity?id={id}&returnUrl={back}", forceLoad: true);
    }
}