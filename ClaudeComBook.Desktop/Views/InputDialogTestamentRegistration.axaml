<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeComBook.Desktop.Views.InputDialogTestamentRegistration"
        Title="Введіть дані"
        Width="400"
        Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#3F51B5">

	<Window.Styles>
		<Style Selector="TextBox /template/ ScrollViewer">
			<Setter Property="Foreground" Value="Black"/>
		</Style>
	</Window.Styles>

	<Grid Margin="20"
          RowDefinitions="Auto,*,Auto">

		<!-- Повідомлення -->
		<TextBlock Grid.Row="0"
                   Name="MessageText"
                   Foreground="White"
                   FontSize="14"
                   Margin="0,0,0,15"/>

		<!-- Поля -->
		<ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

			<StackPanel Spacing="10">

				<StackPanel>
					<TextBlock Text="Номер заповіту"
                               Foreground="White"
                               Margin="0,0,0,5"/>
					<TextBox Name="InputBoxTestamentNumber"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Місце народження заповідача"
                               Foreground="White"
                               Margin="0,0,0,5"/>
					<TextBox Name="InputBoxTestamentPlaceOfBirth"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Поштовий індекс заповідача"
                               Foreground="White"
                               Margin="0,0,0,5"/>
					<TextBox Name="InputBoxTestamentPostalCode"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Дата реєстрації заповіту"
                               Foreground="White"
                               Margin="0,0,0,5"/>
					<TextBox Name="InputBoxTestamentRegistrationDate"/>
				</StackPanel>

			</StackPanel>

		</ScrollViewer>

		<!-- Кнопки -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Spacing="10">

			<Button Content="OK"
                    Width="100"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="OnOkClick"/>

			<Button Content="Скасувати"
                    Width="100"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="OnCancelClick"/>

		</StackPanel>

	</Grid>

</Window>