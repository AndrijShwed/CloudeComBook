<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeComBook.Desktop.Views.InputDialog"
        Title="Введіть дані"
        Width="300" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#3F51B5">
	<Window.Styles>
		<Style Selector="TextBox /template/ ScrollViewer">
			<Setter Property="Foreground" Value="Black"/>
		</Style>
	</Window.Styles>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Повідомлення -->
		<TextBlock Grid.Row="0"
				   Name="MessageText"
				   Foreground="White"
				   FontSize="14"
				   Margin="0,0,0,15"/>

		<!-- Номер довідки -->
		<StackPanel Grid.Row="1" Margin="0,0,0,15">
			<TextBlock Text="Номер довідки"
					   Foreground="White"
					   Margin="0,0,0,5"/>
			<TextBox Name="InputBox"
					 Background="White"
					 Foreground="Black"/>
		</StackPanel>

		<!-- Кнопки -->
		<StackPanel Grid.Row="4"
					Orientation="Horizontal"
					HorizontalAlignment="Right">
			<Button Content="OK"
					Background="#4CAF50"
					Foreground="White"
					FontWeight="Bold"
					Padding="20,8"
					Margin="0,0,10,0"
					Click="OnOkClick"/>

			<Button Content="Скасувати"
					Background="#F44336"
					Foreground="White"
					FontWeight="Bold"
					Padding="20,8"
					Click="OnCancelClick"/>
		</StackPanel>
	</Grid>
	
</Window>
