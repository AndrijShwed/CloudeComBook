<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeComBook.Desktop.Views.InputDialog"
        Title="Введіть дані"
        Width="500" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#3F51B5">
	<Window.Styles>
		<Style Selector="TextBox /template/ ScrollViewer">
			<Setter Property="Foreground" Value="Black"/>
		</Style>
	</Window.Styles>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Повідомлення -->
		<TextBlock Grid.Row="0"
				   Name="MessageText"
				   Foreground="White"
				   FontSize="14"
				   Margin="0,0,0,15"/>

		<!-- Номер довідки -->
		<StackPanel Grid.Row="1" Margin="0,0,0,15">
			<TextBlock Text="Номер довідки"
					   Foreground="White"
					   Margin="0,0,0,5"/>
			<TextBox Name="InputBox1"
					 Background="White"
					 Foreground="Black"/>
		</StackPanel>

		<!-- Посада 1 / Ім'я та прізвище -->
		<Grid Grid.Row="2" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="Посада 1"
						   Foreground="White"
						   Margin="0,0,0,5"/>
				<TextBox Name="InputBox2"
						 Background="White"
						 Foreground="Black"/>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Ім'я та прізвище"
						   Foreground="White"
						   Margin="0,0,0,5"/>
				<TextBox Name="InputBox2_1"
						 Background="White"
						 Foreground="Black"/>
			</StackPanel>
		</Grid>

		<!-- Посада 2 / Ім'я та прізвище -->
		<Grid Grid.Row="3" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="Посада 2"
						   Foreground="White"
						   Margin="0,0,0,5"/>
				<TextBox Name="InputBox3"
						 Background="White"
						 Foreground="Black"/>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Ім'я та прізвище"
						   Foreground="White"
						   Margin="0,0,0,5"/>
				<TextBox Name="InputBox3_1"
						 Background="White"
						 Foreground="Black"/>
			</StackPanel>
		</Grid>

		<!-- Кнопки -->
		<StackPanel Grid.Row="4"
					Orientation="Horizontal"
					HorizontalAlignment="Right">
			<Button Content="OK"
					Background="#4CAF50"
					Foreground="White"
					FontWeight="Bold"
					Padding="20,8"
					Margin="0,0,10,0"
					Click="OnOkClick"/>

			<Button Content="Скасувати"
					Background="#F44336"
					Foreground="White"
					FontWeight="Bold"
					Padding="20,8"
					Click="OnCancelClick"/>
		</StackPanel>
	</Grid>
	
</Window>
